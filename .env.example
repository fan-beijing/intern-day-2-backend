# 复制为 .env 后使用：cp .env.example .env
# 数据库文件落在命名卷挂载点，容器重建后数据仍在
DATABASE_URL=sqlite:////app/data/app.db

# 登录会话有效期（分钟）
SESSION_TTL_MINUTES=120

# 允许直连的前端来源，多个用英文逗号分隔
CORS_ORIGINS=http://localhost:5173

# 启动时自动创建的练习账号（密码请改成自己的，不要提交 .env）
SEED_USERNAME=demo
SEED_PASSWORD=

# ── 第三天：记账助手 Agent（模型服务配置，全部只在后端）──────────────
# 未设置 MODEL_API_KEY 时 /agent 端点不会注册，其余接口不受影响。
# 密钥由导师提供，只写进本地 .env；不要提交、不要放进前端环境变量或镜像构建参数。
MODEL_API_KEY=
# DeepSeek 为 OpenAI 兼容接口；换成 OpenAI 官方只需改下面两个值
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_ID=deepseek-chat
