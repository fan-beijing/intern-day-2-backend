{
  "name": "intern-day-2-backend",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceFolder": "/workspaces/intern-day-2-backend",
  "forwardPorts": [8000],
  "postCreateCommand": "uv sync --frozen",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/workspaces/intern-day-2-backend/.venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.analysis.extraPaths": ["/workspaces/intern-day-2-backend"]
      }
    }
  }
}
